{
  "sourceLanguage" : "en",
  "strings" : {
    "capability.audio-result" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Captured in memory: %.1f seconds at %.0f Hz" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Capturado em memória: %.1f segundos a %.0f Hz" } } } },
    "capability.busy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Another request is still finishing. Wait for it to return before starting again." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Outra solicitação ainda está terminando. Aguarde o retorno antes de iniciar outra." } } } },
    "capability.calendar" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calendar" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Calendário" } } } },
    "capability.camera" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Câmera" } } } },
    "capability.cancel" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel this request" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar esta solicitação" } } } },
    "capability.cancelled" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancelled. No result was kept." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cancelado. Nenhum resultado foi mantido." } } } },
    "capability.changed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The request changed. Start a new request explicitly." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A solicitação mudou. Inicie uma nova solicitação de forma explícita." } } } },
    "capability.choose" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose one action" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha uma ação" } } } },
    "capability.complete" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Result shown here on this device only." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Resultado exibido aqui somente neste dispositivo." } } } },
    "capability.contacts" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Contacts" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Contatos" } } } },
    "capability.disclosure" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When needed, permission setup and each data operation require separate taps. A system prompt never starts an operation by itself. Results stay on this screen and are not sent to Dexter's host, engine, chat, or memory." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Quando necessário, a preparação de permissão e cada operação de dados exigem toques separados. Um aviso do sistema nunca inicia uma operação sozinho. Os resultados ficam nesta tela e não são enviados ao host, engine, conversa ou memória do Dexter." } } } },
    "capability.background" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dexter is in the background. The operation was revoked; return and start again with a fresh tap." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Dexter está em segundo plano. A operação foi revogada; volte e inicie novamente com um novo toque." } } } },
    "capability.empty" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No result was available." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum resultado disponível." } } } },
    "capability.expired" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The one-time consent expired. Tap to make a fresh request." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O consentimento de uso único expirou. Toque para fazer uma nova solicitação." } } } },
    "capability.failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local provider could not complete this request." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O provider local não conseguiu concluir esta solicitação." } } } },
    "capability.file-size" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d bytes read in memory" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%d bytes lidos em memória" } } } },
    "capability.files" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Files" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Arquivos" } } } },
    "capability.foreground" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Foreground only · no background delivery" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Somente em primeiro plano · sem entrega em segundo plano" } } } },
    "capability.image-result" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Selected or captured image result" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Imagem selecionada ou capturada" } } } },
    "capability.inactive" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Return Dexter to the foreground. Any capability approval was revoked; start again with a fresh tap." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Traga o Dexter de volta ao primeiro plano. Qualquer aprovação da capacidade foi revogada; recomece com um novo toque." } } } },
    "capability.local-result" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This result stays in this screen's memory and is cleared when you leave." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este resultado fica na memória desta tela e é apagado quando você sair." } } } },
    "capability.location" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Localização" } } } },
    "capability.microphone" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Microfone" } } } },
    "capability.offline" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No result arrived before the local time limit." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum resultado chegou antes do limite local de tempo." } } } },
    "capability.operation-draining" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The previous operation is still finishing. Any late result will be discarded; wait before starting another." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A operação anterior ainda está terminando. Qualquer resultado tardio será descartado; aguarde antes de iniciar outra." } } } },
    "capability.permission-preparation-required" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "First tap Prepare access. Permission setup does not read capability data. After it returns, tap Run once separately." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Primeiro toque em Preparar acesso. Essa etapa não lê dados da capacidade. Depois do retorno, toque em Executar uma vez separadamente." } } } },
    "capability.permission-setup-draining" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System permission setup is still finishing. Wait for it to return; no data operation will start automatically." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A preparação de permissão do sistema ainda está terminando. Aguarde o retorno; nenhuma operação de dados começará automaticamente." } } } },
    "capability.permission-setup-ready" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission setup returned. Tap Run once to start a separate operation." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A preparação de permissão retornou. Toque em Executar uma vez para iniciar uma operação separada." } } } },
    "capability.permission-setup-return" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Return to Dexter. No operation ran while the system prompt was open. Tap Run once when ready." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Volte ao Dexter. Nenhuma operação foi executada enquanto o aviso do sistema estava aberto. Toque em Executar uma vez quando quiser." } } } },
    "capability.preparing-permission" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for the permission setup you started. No capability data is being read." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando a preparação de permissão que você iniciou. Nenhum dado da capacidade está sendo lido." } } } },
    "capability.prepare-permission" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prepare access" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Preparar acesso" } } } },
    "capability.permission-denied" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "iOS did not provide access for this request." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O iOS não concedeu acesso para esta solicitação." } } } },
    "capability.photos" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Photos" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fotos" } } } },
    "capability.ready" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ready. Choose one action and tap to continue." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pronto. Escolha uma ação e toque para continuar." } } } },
    "capability.record-once" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record up to 10 seconds once" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gravar até 10 segundos uma vez" } } } },
    "capability.result" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local result" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Resultado local" } } } },
    "capability.result-rejected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The provider returned data outside this action's limits." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O provider retornou dados fora dos limites desta ação." } } } },
    "capability.running" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for this local request to finish. A late result will be discarded." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando esta solicitação local. Um resultado tardio será descartado." } } } },
    "capability.run-once" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run this action once" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Executar esta ação uma vez" } } } },
    "capability.scope.calendar" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At most 10 upcoming event titles and start times. No notes or participants." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Até 10 títulos e horários de início de eventos futuros. Sem notas ou participantes." } } } },
    "capability.scope.camera" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One still image started by you. Kept in memory; never saved to Photos automatically." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma foto iniciada por você. Fica na memória; nunca é salva automaticamente em Fotos." } } } },
    "capability.scope.contacts" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The name of one contact you select in the iOS picker. No address book listing." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nome de um contato que você escolhe no seletor do iOS. Sem listar a agenda." } } } },
    "capability.scope.files" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One plain-text file you select; at most 1 MiB, read-only, held in memory, and accepted only within 8 seconds." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um arquivo de texto simples que você seleciona; no máximo 1 MiB, somente leitura, em memória e aceito apenas em até 8 segundos." } } } },
    "capability.scope.location" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One coordinate rounded to 0.01° while using Dexter. iOS and your settings determine acquisition precision. No background location." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma coordenada arredondada a 0,01° enquanto você usa o Dexter. O iOS e seus ajustes determinam a precisão coletada. Sem localização em segundo plano." } } } },
    "capability.scope.microphone" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You start one recording of up to 10 seconds. Audio stays in memory and is not transcribed." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você inicia uma gravação de até 10 segundos. O áudio fica na memória e não é transcrito." } } } },
    "capability.scope.photos" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One image you select in the iOS picker. No library enumeration." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma imagem que você escolhe no seletor do iOS. Sem enumerar a biblioteca." } } } },
    "capability.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device capabilities" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Capacidades no iPhone" } } } },
    "capability.unsupported" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device cannot perform that action." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este aparelho não consegue executar essa ação." } } } },
    "capability.used" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This one-time request was already used. Start a fresh request." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta solicitação de uso único já foi usada. Inicie uma nova solicitação." } } } }
  },
  "version" : "1.1"
}
