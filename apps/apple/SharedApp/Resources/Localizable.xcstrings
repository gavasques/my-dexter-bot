        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host did not confirm its owner and installation, so new registrations are unavailable here. Open the updated local host and reopen MCP connections; the old registration path, without confirmation, is not used."
          }
        },
        "pt-BR": {
          "stringUnit": {
