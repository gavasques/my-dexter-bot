    "connections.platform.confirm.disable.message": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the base restarts, new accounts stop connecting through this service. Nothing is deleted on the service."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de reiniciar a base, novas contas deixam de ser conectadas por este serviço. Nada é apagado no serviço."
          }
        }
      }
    },
    "connections.platform.confirm.disable.title": {
