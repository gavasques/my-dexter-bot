    "O host ainda não confirmou esta proposta. Consulte novamente; ela não foi reenviada.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host has not confirmed this proposal yet. Check again; it was not resent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host ainda não confirmou esta proposta. Consulte novamente; ela não foi reenviada."
          }
        }
      }
    },
    "O host conectado guarda os bots, as conversas e as permissões e executa as engines. Este app acessa essa base.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected host stores bots, conversations and permissions and runs the engines. This app accesses that host."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host conectado guarda os bots, as conversas e as permissões e executa as engines. Este app acessa essa base."
          }
        }
      }
    },
    "O host confirmou a interrupção. Isso não desfaz efeitos já realizados.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host confirmed the interruption. This does not undo effects that already happened."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host confirmou a interrupção. Isso não desfaz efeitos já realizados."
          }
        }
      }
    },
    "O host descartou avisos e erros; eles não estão disponíveis neste resultado.": {
      "localizations": {
