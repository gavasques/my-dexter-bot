    "connections.platform.entry.unconfiguredBody": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To sign in to Gmail, Notion and other services on each one's official page, the base needs a connections service you run. It's optional: without it, use a custom connection (MCP) under Advanced."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para entrar no Gmail, no Notion e em outros serviços pela página oficial de cada um, a base precisa de um serviço de conexões que você opera. É opcional: sem ele, use uma conexão personalizada (MCP) em Avançado."
          }
        }
      }
    },
    "connections.platform.forget": {
