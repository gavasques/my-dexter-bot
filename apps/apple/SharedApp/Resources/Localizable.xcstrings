      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this when the credential was replaced or revoked on the service. After the base restarts, paste the new credential; the current one stops being accepted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use quando a credencial foi trocada ou revogada no serviço. Depois de reiniciar a base, cole a nova credencial; a atual deixa de ser aceita."
          }
        }
      }
    },
    "connections.platform.confirm.renew.title": {
