          }
        }
      }
    },
    "voz padrão": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "default voice"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "voz padrão"
          }
        }
      }
    },
    "vê outros bots": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sees other bots"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "vê outros bots"
          }
        }
      }
    },
    "É a mesma decisão, com o mesmo identificador. Se a base já a aplicou, ela devolve o mesmo resultado; nada é decidido duas vezes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same decision, with the same identifier. If the base already applied it, it returns the same result; nothing is decided twice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a mesma decisão, com o mesmo identificador. Se a base já a aplicou, ela devolve o mesmo resultado; nada é decidido duas vezes."
          }
        }
      }
    },
    "É o mesmo pedido, com o mesmo identificador. Se a base já criou o convite, ela devolve esse mesmo resultado; nenhum convite novo é criado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same request, with the same identifier. If the base already created the invitation, it returns that same result; no new invitation is created."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o mesmo pedido, com o mesmo identificador. Se a base já criou o convite, ela devolve esse mesmo resultado; nenhum convite novo é criado."
          }
        }
      }
    },
    "Última falha": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last failure"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última falha"
          }
        }
      }
    },
    "“%@” (%@) será removida. As ferramentas desta conexão saem de todos os bots que as usam. Outras conexões, mesmo com o mesmo endereço, não mudam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” (%@) will be removed. This connection's tools leave every bot that uses them. Other connections, even with the same address, do not change."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” (%@) será removida. As ferramentas desta conexão saem de todos os bots que as usam. Outras conexões, mesmo com o mesmo endereço, não mudam."
          }
        }
      }
    },
    "↑/↓ mudar ação · ⌘⇧D negar · ⌘⇧P permitir · Esc sair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑/↓ change action · ⌘⇧D deny · ⌘⇧P allow · Esc exit"
