    "connections.platform.stage.chooseService.body": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. It's the service you run (for example with Composio) to sign in to Gmail, Notion and others on each one's official page. Without it, use a custom connection (MCP)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. É o serviço que você opera (por exemplo, com Composio) para entrar no Gmail, no Notion e em outros pela página oficial de cada um. Sem ele, use uma conexão personalizada (MCP)."
          }
        }
      }
    },
    "connections.platform.stage.chooseService.title": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your connections service"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
