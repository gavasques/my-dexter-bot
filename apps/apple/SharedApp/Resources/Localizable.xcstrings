    },
    "Cada nome é um apelido dado por você em Gerenciar conexões. O Dexter não confirma qual conta (por exemplo, qual Gmail) está por trás de cada conexão.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each name is a nickname you gave in Manage connections. Dexter does not confirm which account (for example, which Gmail) is behind each connection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nome é um apelido dado por você em Gerenciar conexões. O Dexter não confirma qual conta (por exemplo, qual Gmail) está por trás de cada conexão."
          }
        }
      }
    },
