    "connections.platform.requirements.after": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once set up and with the base restarted, this section shows the services and Connect opens each one's official page in your browser. Connecting an account never gives a bot access by itself."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de configurado e com a base reiniciada, esta seção mostra os serviços e Conectar abre a página oficial de cada um no seu navegador. Conectar uma conta nunca libera a conta para um bot sozinho."
          }
        }
      }
    },
    "connections.platform.requirements.delivery": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A way for the owner to hand both to the base: Set up connections service…, in the Dexter that starts this Mac's base. On another base or a VPS this isn't available in this app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jeito de o dono entregar essas duas coisas à base: em Configurar serviço de conexões…, no Dexter que inicia a base deste Mac. Em outra base ou numa VPS isso não está disponível neste app."
          }
        }
      }
    },
