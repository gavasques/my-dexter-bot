    "versão %@, somente para este bot. Habilidades não concedem ferramentas, contas ou acessos; permissões e habilidades herdadas continuam como estão. A base confere se esta versão continua a mesma.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "version %@, for this bot only. Skills grant no tools, accounts or access; permissions and inherited skills stay as they are. The host checks that this version is still the same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "versão %@, somente para este bot. Habilidades não concedem ferramentas, contas ou acessos; permissões e habilidades herdadas continuam como estão. A base confere se esta versão continua a mesma."
          }
        }
      }
    },
