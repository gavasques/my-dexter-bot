      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The base couldn't read the connections service configuration and used none. Check again; if it persists, save the address again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A base não conseguiu ler a configuração do serviço de conexões e não usou nenhum. Consulte de novo; se continuar, salve o endereço outra vez."
          }
        }
      }
    },
