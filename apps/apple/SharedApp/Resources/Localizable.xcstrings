      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credential only reaches the base through the private channel of the Dexter that started it. Use the Dexter that starts this Mac's base; this isn't available on a VPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial só chega à base pelo canal privado do Dexter que a iniciou. Use o Dexter que inicia a base deste Mac; numa VPS isso não está disponível."
          }
        }
      }
    },
    "connections.platform.renew": {
      "comment": "Owner-private connections service configuration (Conectar apps)",
