          "stringUnit": {
            "state": "translated",
            "value": "Once enabled and the key is saved, the chat's voice button uses live voice in conversations without a native call. The microphone is used only when you start a session."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de habilitar e salvar a chave, o botão de voz do chat usa a voz ao vivo nas conversas sem chamada nativa. O microfone só é usado quando você inicia uma sessão."
          }
        }
      }
    },
