          }
        }
      }
    },
    "Os bots desta base deixam de aparecer neste app até você usar o host local de novo. Nada é apagado na base.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This base's bots stop showing in this app until you use the local host again. Nothing is deleted on the base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os bots desta base deixam de aparecer neste app até você usar o host local de novo. Nada é apagado na base."
          }
        }
      }
    },
    "Os bots do time salvam aqui o que criam para o time. Mudar onde ficam os arquivos novos nunca move nem apaga os que já existem.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The team's bots save here what they create for the team. Changing where new files go never moves or deletes existing ones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os bots do time salvam aqui o que criam para o time. Mudar onde ficam os arquivos novos nunca move nem apaga os que já existem."
          }
