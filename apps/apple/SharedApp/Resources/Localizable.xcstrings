    },
    "O texto deste convite deixa de funcionar. Aparelhos que já entraram não são afetados.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation's text stops working. Devices that already joined aren't affected."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto deste convite deixa de funcionar. Aparelhos que já entraram não são afetados."
          }
        }
      }
    },
    "O texto deste convite já foi entregue o máximo de vezes. Cancele-o e crie outro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation's text was already delivered the maximum number of times. Cancel it and create another one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto deste convite já foi entregue o máximo de vezes. Cancele-o e crie outro."
          }
        }
      }
    },
    "O texto não fica salvo neste aparelho. Reescreva exatamente a mensagem original para repetir o mesmo ID. Se o host já a aceitou, a conversa confirmará o envio ao atualizar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is not saved on this device. Re-enter the exact original message to retry with the same ID. If the host already accepted it, refreshing the conversation will confirm the submission."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto não fica salvo neste aparelho. Reescreva exatamente a mensagem original para repetir o mesmo ID. Se o host já a aceitou, a conversa confirmará o envio ao atualizar."
          }
        }
      }
    },
