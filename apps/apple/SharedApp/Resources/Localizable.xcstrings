    "connections.platform.lock": {
      "comment": "Owner-private connections service configuration (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock on the base"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear na base"
          }
        }
      }
    },
    "connections.platform.lockNote": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking removes the credential from the base's memory. When Connect apps or Dexter opens again, the stored credential is handed over again; to stop for good, forget the credential or turn the service off. None of this revokes accounts on the service."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear tira a credencial da memória da base. Ao abrir Conectar apps ou o Dexter de novo, a credencial guardada é entregue outra vez; para parar de vez, esqueça a credencial ou desative o serviço. Nada disso revoga contas no serviço."
          }
        }
      }
    },
    "connections.platform.notConnected": {
      "comment": "Owner-private connections service configuration (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configured is not connected: the catalog proves the connection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurado não significa conectado: a conexão é comprovada pelo catálogo."
          }
        }
      }
    },
