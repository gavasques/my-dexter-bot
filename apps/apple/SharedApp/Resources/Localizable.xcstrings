        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot pode ser criado, mas só responderá quando este assistente estiver disponível nesta base. Confira em Ajustes › Assistentes."
          }
        }
      }
    },
    "O bot poderá %@ o arquivo %@ com o nome %@. O host continua pedindo aprovação de cada ferramenta.": {
      "localizations": {
