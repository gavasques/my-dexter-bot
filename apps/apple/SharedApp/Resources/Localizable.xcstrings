    },
    "Este app ainda não está conectado a essa base. Use Conectar a outra base… Ligar o agente deste Mac não conecta o app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not connected to that base yet. Use Connect to Another Base… Turning on this Mac's agent does not connect the app."
