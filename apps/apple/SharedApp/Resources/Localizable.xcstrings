    "connections.platform.confirm.forget.button": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer"
          }
        }
      }
    },
    "connections.platform.confirm.forget.message": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the credential from this Mac's Keychain and asks the base to lock it. It doesn't revoke anything on the service or the accounts; use your service's dashboard for that."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga a credencial do Keychain deste Mac e pede à base que a bloqueie. Não revoga nada no serviço nem nas contas; para isso, use o painel do seu serviço."
          }
        }
      }
    },
    "connections.platform.confirm.forget.title": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the credential on this Mac?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer a credencial deste Mac?"
          }
        }
      }
    },
    "connections.platform.confirm.renew.button": {
      "comment": "Owner-private connections service setup (Conectar apps)",
      "extractionState": "manual",
      "localizations": {
