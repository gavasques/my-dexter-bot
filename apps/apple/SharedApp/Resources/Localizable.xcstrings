    "O Dexter cuida do programa e da conexão. Sua conta continua no assistente oficial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dexter handles the program and connection. Your account stays with the official assistant."
