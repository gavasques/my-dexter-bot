        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi criado aqui ainda."
          }
        }
      }
    },
    "Nada foi enviado ainda. Pedir aprovação cria o pedido; ele só vale depois que você aprovar.": {
      "localizations": {
        "en": {
