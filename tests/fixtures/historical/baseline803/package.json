{
  "name": "dexter-bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "pnpm build && tsc -p tsconfig.tests.json --noEmit",
    "test": "node scripts/run-node-tests.mjs",
    "check": "pnpm test && pnpm status:test",
    "dexter": "node packages/cli/dist/index.js",
    "status": "node apps/status/start.mjs",
    "status:test": "node --test tests/status-dashboard.test.mjs"
  },
  "devDependencies": {
    "@dexter/contracts": "workspace:*",
    "@dexter/engines": "workspace:*",
    "@dexter/hub": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "@dexter/gateway": "workspace:*",
    "@dexter/context": "workspace:*",
    "@dexter/connectors": "workspace:*",
    "@dexter/devices": "workspace:*",
    "@dexter/agenda": "workspace:*",
    "@dexter/relay": "workspace:*",
    "@dexter/operations": "workspace:*",
    "@dexter/relay-service": "workspace:*",
    "@dexter/relay-consumer": "workspace:*",
    "zod": "4.6.5",
    "hono": "4.13.13",
    "@hono/node-server": "2.1.3",
    "@dexter/relay-host": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1"
  }
}
